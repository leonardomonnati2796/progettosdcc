FROM golang:1.24-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/service-cli ./cmd/service-cli

FROM alpine:3.20

WORKDIR /app
COPY --from=builder /out/service-cli /usr/local/bin/service-cli

ENTRYPOINT ["service-cli"]
